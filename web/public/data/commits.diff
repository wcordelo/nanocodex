+
+fn rendered_paragraph(
+    entry: &TranscriptEntry,
+    index: usize,
+    width: u16,
+    inline_edit: Option<InlineEdit<'_>>,
+) -> Paragraph<'static> {
+    inline_edit.filter(|edit| edit.index == index).map_or_else(
+        || entry.paragraph(),
+        |edit| {
+            Paragraph::new(inline_edit_text(edit.input, width))
+                .block(
