+  grid-template-columns: minmax(0, 1fr) auto;
+  gap: 10px;
+  align-items: center;
+  margin-top: 14px;
+  padding: 10px 10px 10px 12px;
+  background: var(--surface-subtle);
+  border-radius: var(--radius-small);
+}
+
+.home-install-command code {
+  min-width: 0;
+  overflow: hidden;
+  font-size: 11px;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.home-install-command button {
+  display: inline-flex;
+  gap: 6px;
+  align-items: center;
+  min-height: 28px;
+  padding: 0 9px;
+  background: var(--surface-raised);
+  border: 1px solid var(--border-soft);
+  border-radius: var(--radius-small);
+  cursor: pointer;
+}
+
+.home-install-command button:hover,
+.home-install-command button:focus-visible {
+  border-color: var(--border);
+}
+
+.home-install-command button svg {
+  width: 12px;
+  height: 12px;
+}
+
+.home-release-grid {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: 16px;
+  margin-top: 16px;
+}
+
+.home-release-grid article {
+  display: grid;
+  align-content: start;
+  gap: 5px;
+  min-width: 0;
+}
+
+.home-release-grid article > span {
+  color: var(--text-muted);
+  font-size: 9px;
+  letter-spacing: 0.04em;
+  text-transform: uppercase;
+}
+
+.home-release-grid article > code,
+.home-release-grid article > a {
+  min-width: 0;
+  overflow: hidden;
+  color: var(--text);
+  font-size: 11px;
+  font-weight: 600;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.home-release-grid article > p {
+  color: var(--text-muted);
+  font-size: 10px;
+  line-height: 1.4;
+}
