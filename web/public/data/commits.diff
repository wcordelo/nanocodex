-                                content,
-                                stored,
-                            });
-                        }
-                        RuntimeEvent::Error {
-                            message,
-                            content,
-                            stored,
-                            ..
-                        } => {
-                            return Ok(CellTerminal::ScriptFailed {
-                                message,
-                                content,
-                                stored,
-                            });
-                        }
-                    }
-                }
-            }
-        }
-    }
