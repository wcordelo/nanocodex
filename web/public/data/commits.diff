+    pub(super) time_to_first_event_ns: u64,
+    pub(super) time_to_first_output_ns: Option<u64>,
+    pub(super) usage: Option<&'a Usage>,
+}
+
+#[derive(Serialize)]
+pub(super) struct CompactionFailed<'a> {
