+        let duration_ns = elapsed_ns(started_at);
+        self.stats.model_duration_ns += duration_ns;
+        let message = error.to_string();
+        self.events.emit(
+            "model.call.failed",
+            ModelCallFailed {
+                call_index,
+                model: &self.config.model,
+                duration_ns,
+                error: &message,
+            },
+        )?;
+        Err(error)
     }
