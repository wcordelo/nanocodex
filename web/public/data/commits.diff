+            .await
+            .map_err(|_| WebSocketError::ConnectionClosed)?;
+        receiver
+            .await
+            .unwrap_or(Err(WebSocketError::ConnectionClosed))
+    }
+
+    async fn next(&mut self) -> Option<std::result::Result<Message, WebSocketError>> {
+        self.messages.recv().await
