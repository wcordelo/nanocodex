+        status: LocalShellStatus,
+        action: LocalShellAction,
+        #[serde(default, skip_serializing_if = "Option::is_none")]
+        internal_chat_message_metadata_passthrough: Option<InternalMessageMetadata>,
+    },
+    FunctionCall {
