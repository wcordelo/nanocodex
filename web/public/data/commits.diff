+fn rendered_height(
+    entry: &TranscriptEntry,
+    index: usize,
+    width: u16,
+    inline_edit: Option<InlineEdit<'_>>,
+) -> usize {
+    inline_edit.filter(|edit| edit.index == index).map_or_else(
+        || entry.height(width),
