-                    let event = event?;
-                    let event_cell_id = event.cell_id();
-                    if event_cell_id != cell_id {
-                        return Err(HostFailure::new(format!(
-                            "local code-mode host returned cell {event_cell_id} while executing cell {cell_id}"
-                        )));
-                    }
