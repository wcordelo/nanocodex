+    let visible = selected_bounds.is_some_and(|(bottom, top)| {
+        top <= viewport_top_from_bottom.saturating_sub(PADDING.min(viewport_height))
+            && bottom >= scroll_from_bottom.saturating_add(PADDING.min(viewport_height))
+    });
