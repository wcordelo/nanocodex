+
+pub fn system_prompt() -> String {
+    format!("{IDENTITY}\n\n{WORKFLOW}\n\n{OUTPUT}\n")
+}
+
+pub fn diagnostic_prompt() -> String {
+    let first = IDENTITY;
+    let second = WORKFLOW;
+    let third = OUTPUT;
+    format!("{first}\n\n{second}\n\n{third}\n")
+}
+
+#[cfg(test)]
