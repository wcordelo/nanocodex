+  const options = useMemo<CodeViewOptions<CommitAnnotation>>(
+    () => ({
+      layout: CODE_VIEW_LAYOUT,
+      theme: DEFAULT_THEMES,
+      themeType: theme,
+      diffStyle: "unified",
+      diffIndicators: "bars",
+      overflow: "scroll",
+      lineHoverHighlight: "number",
+      enableLineSelection: true,
+      stickyHeaders: true,
+      itemMetrics: {
+        lineHeight: 18,
+        diffHeaderHeight: 44,
+      },
+      unsafeCSS: COMMIT_CODE_VIEW_CUSTOM_CSS,
+    }),
+    [theme],
+  );
