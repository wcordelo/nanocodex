+        append_branch_tree(root, &nodes, &mut guides, None, &mut visited, &mut ordered);
+    }
+    for (id, _) in &nodes {
+        append_branch_tree(*id, &nodes, &mut guides, None, &mut visited, &mut ordered);
+    }
